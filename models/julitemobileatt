"""
Ju-LiteMobileAtt
----------------

Paper:
    Ju-LiteMobileAtt:
    A lightweight attention network
    for efficient jujube defect classification

Core Idea:
    MobileNetV2
    + CoordAtt
    + EfficientRCAM
    + CascadedRCAM

Features:
    - Lightweight
    - Edge-friendly
    - Multi-scale attention
    - Fine-grained defect learning

Research-style implementation
(reconstructed from paper description)

Author:
    Reconstructed implementation
"""

from __future__ import annotations

import math
import torch
import torch.nn as nn


# ============================================================
# Utility
# ============================================================

def _make_divisible(v, divisor=8):

    return int(math.ceil(v / divisor) * divisor)


def conv_bn_act(
    in_ch,
    out_ch,
    k=3,
    s=1,
    g=1,
    act=True
):

    layers = [
        nn.Conv2d(
            in_ch,
            out_ch,
            kernel_size=k,
            stride=s,
            padding=k // 2,
            groups=g,
            bias=False
        ),
        nn.BatchNorm2d(out_ch)
    ]

    if act:
        layers.append(nn.Hardswish(inplace=True))

    return nn.Sequential(*layers)


# ============================================================
# CoordAttention
# ============================================================

class CoordAttention(nn.Module):

    """
    Coordinate Attention
    (paper-inspired implementation)
    """

    def __init__(self, channels, reduction=32):

        super().__init__()

        hidden = max(8, channels // reduction)

        self.pool_h = nn.AdaptiveAvgPool2d((None, 1))
        self.pool_w = nn.AdaptiveAvgPool2d((1, None))

        self.conv1 = nn.Conv2d(
            channels,
            hidden,
            kernel_size=1,
            bias=False
        )

        self.bn1 = nn.BatchNorm2d(hidden)

        self.act = nn.Hardswish(inplace=True)

        self.conv_h = nn.Conv2d(
            hidden,
            channels,
            kernel_size=1,
            bias=False
        )

        self.conv_w = nn.Conv2d(
            hidden,
            channels,
            kernel_size=1,
            bias=False
        )

    def forward(self, x):

        identity = x

        n, c, h, w = x.shape

        x_h = self.pool_h(x)
        x_w = self.pool_w(x).permute(0, 1, 3, 2)

        y = torch.cat([x_h, x_w], dim=2)

        y = self.act(self.bn1(self.conv1(y)))

        x_h, x_w = torch.split(y, [h, w], dim=2)

        x_w = x_w.permute(0, 1, 3, 2)

        a_h = torch.sigmoid(self.conv_h(x_h))
        a_w = torch.sigmoid(self.conv_w(x_w))

        out = identity * a_h * a_w

        return out


# ============================================================
# EfficientRCAM
# ============================================================

class EfficientRCAM(nn.Module):

    """
    Efficient Residual Coordinate Attention Module

    Paper ideas:
        - Depthwise convolution
        - CoordAtt
        - Residual fusion
        - Lightweight channel compression
    """

    def __init__(
        self,
        channels,
        expand_ratio=2
    ):

        super().__init__()

        hidden = channels * expand_ratio

        # expansion
        self.expand = conv_bn_act(
            channels,
            hidden,
            k=1
        )

        # depthwise
        self.dwconv = conv_bn_act(
            hidden,
            hidden,
            k=3,
            g=hidden
        )

        # attention
        self.ca = CoordAttention(hidden)

        # projection
        self.project = nn.Sequential(
            nn.Conv2d(
                hidden,
                channels,
                kernel_size=1,
                bias=False
            ),
            nn.BatchNorm2d(channels)
        )

        self.act = nn.Hardswish(inplace=True)

    def forward(self, x):

        identity = x

        x = self.expand(x)

        x = self.dwconv(x)

        x = self.ca(x)

        x = self.project(x)

        x = x + identity

        x = self.act(x)

        return x


# ============================================================
# CascadedRCAM
# ============================================================

class CascadedRCAM(nn.Module):

    """
    Cascaded Residual Coordinate Attention Module

    Multi-scale residual enhancement.
    """

    def __init__(self, channels):

        super().__init__()

        self.block1 = EfficientRCAM(channels)

        self.block2 = EfficientRCAM(channels)

        self.fusion = conv_bn_act(
            channels * 2,
            channels,
            k=1
        )

    def forward(self, x):

        identity = x

        y1 = self.block1(x)

        y2 = self.block2(y1)

        out = torch.cat([identity, y2], dim=1)

        out = self.fusion(out)

        return out


# ============================================================
# Inverted Residual Block
# ============================================================

class InvertedResidual(nn.Module):

    def __init__(
        self,
        in_ch,
        out_ch,
        stride,
        expand_ratio,
        use_attention=False
    ):

        super().__init__()

        hidden_dim = in_ch * expand_ratio

        self.use_residual = (
            stride == 1 and in_ch == out_ch
        )

        layers = []

        # expansion
        if expand_ratio != 1:

            layers.append(
                conv_bn_act(
                    in_ch,
                    hidden_dim,
                    k=1
                )
            )

        # depthwise
        layers.append(
            conv_bn_act(
                hidden_dim,
                hidden_dim,
                k=3,
                s=stride,
                g=hidden_dim
            )
        )

        # projection
        layers.append(
            nn.Sequential(
                nn.Conv2d(
                    hidden_dim,
                    out_ch,
                    kernel_size=1,
                    bias=False
                ),
                nn.BatchNorm2d(out_ch)
            )
        )

        self.block = nn.Sequential(*layers)

        self.attention = (
            CascadedRCAM(out_ch)
            if use_attention else nn.Identity()
        )

    def forward(self, x):

        out = self.block(x)

        out = self.attention(out)

        if self.use_residual:
            out = out + x

        return out


# ============================================================
# Ju-LiteMobileAtt
# ============================================================

class JuLiteMobileAtt(nn.Module):

    """
    Reconstructed Ju-LiteMobileAtt
    """

    def __init__(
        self,
        num_classes=6,
        width_mult=1.0
    ):

        super().__init__()

        def c(ch):
            return _make_divisible(ch * width_mult)

        # ----------------------------------------------------
        # stem
        # ----------------------------------------------------

        self.stem = conv_bn_act(
            3,
            c(32),
            k=3,
            s=2
        )

        # ----------------------------------------------------
        # MobileNetV2 stages
        # ----------------------------------------------------

        self.stage0 = InvertedResidual(
            c(32),
            c(16),
            stride=1,
            expand_ratio=1
        )

        self.stage1 = nn.Sequential(

            InvertedResidual(
                c(16),
                c(24),
                stride=2,
                expand_ratio=6
            ),

            InvertedResidual(
                c(24),
                c(24),
                stride=1,
                expand_ratio=6,
                use_attention=True
            )
        )

        self.stage2 = nn.Sequential(

            InvertedResidual(
                c(24),
                c(32),
                stride=2,
                expand_ratio=6
            ),

            InvertedResidual(
                c(32),
                c(32),
                stride=1,
                expand_ratio=6
            ),

            InvertedResidual(
                c(32),
                c(32),
                stride=1,
                expand_ratio=6,
                use_attention=True
            )
        )

        self.stage3 = nn.Sequential(

            InvertedResidual(
                c(32),
                c(64),
                stride=2,
                expand_ratio=6
            ),

            InvertedResidual(
                c(64),
                c(64),
                stride=1,
                expand_ratio=6
            ),

            InvertedResidual(
                c(64),
                c(64),
                stride=1,
                expand_ratio=6
            ),

            InvertedResidual(
                c(64),
                c(64),
                stride=1,
                expand_ratio=6,
                use_attention=True
            )
        )

        self.stage4 = nn.Sequential(

            InvertedResidual(
                c(64),
                c(96),
                stride=1,
                expand_ratio=6
            ),

            InvertedResidual(
                c(96),
                c(96),
                stride=1,
                expand_ratio=6
            ),

            InvertedResidual(
                c(96),
                c(96),
                stride=1,
                expand_ratio=6,
                use_attention=True
            )
        )

        self.stage5 = nn.Sequential(

            InvertedResidual(
                c(96),
                c(160),
                stride=2,
                expand_ratio=6
            ),

            InvertedResidual(
                c(160),
                c(160),
                stride=1,
                expand_ratio=6
            ),

            InvertedResidual(
                c(160),
                c(160),
                stride=1,
                expand_ratio=6,
                use_attention=True
            )
        )

        self.stage6 = InvertedResidual(
            c(160),
            c(320),
            stride=1,
            expand_ratio=6,
            use_attention=True
        )

        # ----------------------------------------------------
        # head
        # ----------------------------------------------------

        self.head = conv_bn_act(
            c(320),
            c(1280),
            k=1
        )

        self.pool = nn.AdaptiveAvgPool2d(1)

        self.dropout = nn.Dropout(0.2)

        self.classifier = nn.Linear(
            c(1280),
            num_classes
        )

        self._init_weights()

    # --------------------------------------------------------

    def _init_weights(self):

        for m in self.modules():

            if isinstance(m, nn.Conv2d):

                nn.init.kaiming_normal_(
                    m.weight,
                    mode='fan_out'
                )

            elif isinstance(m, nn.BatchNorm2d):

                nn.init.ones_(m.weight)
                nn.init.zeros_(m.bias)

            elif isinstance(m, nn.Linear):

                nn.init.normal_(m.weight, 0, 0.01)

                if m.bias is not None:
                    nn.init.zeros_(m.bias)

    # --------------------------------------------------------

    def forward_features(self, x):

        feats = {}

        x = self.stem(x)
        feats["stem"] = x

        x = self.stage0(x)
        feats["stage0"] = x

        x = self.stage1(x)
        feats["stage1"] = x

        x = self.stage2(x)
        feats["stage2"] = x

        x = self.stage3(x)
        feats["stage3"] = x

        x = self.stage4(x)
        feats["stage4"] = x

        x = self.stage5(x)
        feats["stage5"] = x

        x = self.stage6(x)
        feats["stage6"] = x

        return feats

    # --------------------------------------------------------

    def forward(self, x):

        x = self.stem(x)

        x = self.stage0(x)

        x = self.stage1(x)

        x = self.stage2(x)

        x = self.stage3(x)

        x = self.stage4(x)

        x = self.stage5(x)

        x = self.stage6(x)

        x = self.head(x)

        x = self.pool(x)

        x = torch.flatten(x, 1)

        x = self.dropout(x)

        x = self.classifier(x)

        return x

    # --------------------------------------------------------

    def count_parameters(self):

        return sum(
            p.numel()
            for p in self.parameters()
            if p.requires_grad
        )

    # --------------------------------------------------------

    def __repr__(self):

        params = self.count_parameters()

        return (
            f"JuLiteMobileAtt("
            f"params={params:,})"
        )


# ============================================================
# Factory
# ============================================================

def julitemobileatt(
    num_classes=6,
    width_mult=1.0
):

    return JuLiteMobileAtt(
        num_classes=num_classes,
        width_mult=width_mult
    )


# ============================================================
# build_model
# ============================================================

def build_model(
    name="julitemobileatt",
    num_classes=6,
    width_mult=1.0,
    **kwargs
):

    if name != "julitemobileatt":

        raise ValueError(
            f"Unknown model: {name}"
        )

    return JuLiteMobileAtt(
        num_classes=num_classes,
        width_mult=width_mult
    )


